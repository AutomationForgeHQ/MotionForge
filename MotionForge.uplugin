{
  "FileVersion": 3,
  "Version": 4,
  "VersionName": "0.3.1",
  "FriendlyName": "MotionForge",
  "Description": "Describe a motion, generate it with an AI motion provider, and get a game-ready animation sequence imported onto the skeleton you chose. Owns one pipeline end to end - submit, poll, review, download, import (an optional Blender normalisation pass exists but is off by default). Standalone: no gameplay framework dependency, no montages, no curves, no notifies. Those belong to adapters built on top.",
  "Category": "Automation Forge",
  "CreatedBy": "Bojan Andrejek",
  "CreatedByURL": "https://kovati.dev",
  "DocsURL": "https://github.com/AutomationForgeHQ/MotionForge",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/AutomationForgeHQ/MotionForge/issues",
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "MotionForge",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "MotionForgeEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    }
  ],
  "Plugins": [
    {
      "Name": "IKRig",
      "Enabled": true,
      "Comment": "Providers hand back a normalised rig, not the one they were given, so finished clips are retargeted onto the project's skeleton rather than imported straight onto it."
    },
    {
      "Name": "ControlRig",
      "Enabled": true,
      "Comment": "A prompt sequence carries a disabled rig to pose constraints on. Naming a rig is optional per character, so a project that never poses one pays nothing but the dependency."
    }
  ]
}
